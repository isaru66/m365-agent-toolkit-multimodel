NODE_ENV=development
LOCAL_PLAYGROUND=true
ALLOW_LOCAL_LIVE_PROVIDERS=false
PROVIDER_MODE=mock
ENABLED_PROVIDERS=claude,gemini
STATE_STORE=memory
PORT=3978
MAX_OUTPUT_TOKENS=2048
MAX_INPUT_CHARS=12000
MAX_CONTEXT_BYTES=80000
STREAM_TIMEOUT_MS=90000

# For authenticated Teams, set LOCAL_PLAYGROUND=false and configure bot identity.
# For real models, set PROVIDER_MODE=live and supply API keys outside source control.
# Local live calls also require ALLOW_LOCAL_LIVE_PROVIDERS=true (billable).
# Keep that flag false outside local Playground. Never expose Playground publicly.
# CLIENT_ID=
# CLIENT_SECRET=
# TENANT_ID=

# Shared by local application startup and tests\http requests.
# REST Client requests call providers directly even when PROVIDER_MODE=mock.
# Populate locally; keep credentials out of source control.
# Absent ENABLED_PROVIDERS preserves claude,gemini; explicit lists must be nonempty
# and unique. Claude-only: claude. All three: claude,gemini,azure-openai.
# Live mode requires key + explicit base URL + model/deployment for enabled only.
# Replace placeholder URLs with verified inference bases, without trailing slashes.
# Foundry /api/projects/... is NOT an inference endpoint.
ANTHROPIC_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/anthropic
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
# Claude accepts your Azure deployment alias; verify the intended model yourself.
CLAUDE_MODEL=
GEMINI_MODEL=
AZURE_OPENAI_DEPLOYMENT=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=

# Manual tests\http\gemini-vertex.http uses project-based Vertex AI, not the app's
# Gemini Developer API settings above. Bearer auth needs an OAuth access token.
# Example project: isaru66gcp. Keep tokens local and refresh when they expire.
VERTEX_AI_BASE_URL=https://aiplatform.googleapis.com
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_ACCESS_TOKEN=

# ACA uses Cosmos and managed identity, not a database key.
# STATE_STORE=cosmos
# COSMOS_ENDPOINT=
# COSMOS_DATABASE=teams-agent
# COSMOS_CONTAINER=conversations
# AZURE_CLIENT_ID=
# APPLICATIONINSIGHTS_CONNECTION_STRING=
