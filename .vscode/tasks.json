{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start local agent",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": { "regexp": "^(?!)$", "file": 1, "message": 1 },
        "background": { "activeOnStart": true, "beginsPattern": ".", "endsPattern": "\"event\":\"app_started\"" }
      }
    },
    {
      "label": "Start Agents Playground",
      "type": "shell",
      "command": "npm run playground",
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    { "label": "Terraform plan (WSL)", "type": "shell", "command": "npm run infra:plan -- --wsl", "problemMatcher": [] }
  ]
}
