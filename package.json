{
  "name": "teams-multimodel-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "infra:plan": "node scripts/provision.mjs",
    "infra:apply": "node scripts/provision.mjs --apply",
    "deploy:aca": "node scripts/deploy.mjs",
    "toolkit:sync": "node scripts/sync-toolkit-env.mjs",
    "playground": "agentsplayground -e http://127.0.0.1:3978/api/messages -c emulator"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@azure/cosmos": "4.10.1",
    "@azure/identity": "4.13.3",
    "@azure/monitor-opentelemetry": "1.20.0",
    "@google/genai": "2.21.0",
    "@microsoft/teams.api": "2.1.0",
    "@microsoft/teams.apps": "2.1.0",
    "@microsoft/teams.common": "2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@microsoft/m365agentstoolkit-cli": "1.1.16",
    "@microsoft/m365agentsplayground": "0.2.28",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "eslint": "9.39.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
